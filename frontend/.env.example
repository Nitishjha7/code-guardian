# Backend base URL used by the browser.
#
# Leave as /api for local dev (vite proxies it to :8000) and for the Docker
# stack (nginx proxies it to the backend container). Only set a full URL when
# the frontend is deployed separately from the backend - e.g. Cloudflare Pages
# in front of a Render backend:
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=/api
