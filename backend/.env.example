# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Model used by every agent. Must be a model your Groq key can actually see -
# check with: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Groq retires model ids over time; llama-3.3-70b-versatile is gone as of 2026.
#   openai/gpt-oss-120b  (default: strong, supports tool calling)
#   openai/gpt-oss-20b   (cheaper/faster, fine for smoke tests)
#   qwen/qwen3.8-27b
GUARDIAN_MODEL=openai/gpt-oss-120b

# Optional. Comma-separated Groq model ids tried in order if GUARDIAN_MODEL
# fails or is rate limited - a real gap this project has already hit (Groq
# retired llama-3.3-70b-versatile mid-project with no warning). Empty by
# default: one project, one key, one honest default model. This is a
# same-provider fallback, not a multi-provider gateway - it protects against
# a retired or saturated model id, not against Groq itself being unreachable.
GUARDIAN_FALLBACK_MODELS=openai/gpt-oss-20b

# Comma-separated CORS origins for the React dev server / deployed frontend
GUARDIAN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Phase 2: GitHub PR bot ---
# Personal access token with repo scope (or a fine-grained token with Contents +
# Pull requests read/write). Needed to read PR diffs and post the review comment.
GITHUB_TOKEN=

# Shared secret for webhook signature verification. Generate with:
#   openssl rand -hex 32
# The webhook FAILS CLOSED: if this is empty, deliveries are rejected with 503.
GITHUB_WEBHOOK_SECRET=
