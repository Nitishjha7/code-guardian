# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Model used by every agent. Groq model ids:
#   llama-3.3-70b-versatile  (default, best quality)
#   llama-3.1-8b-instant     (cheap/fast, fine for smoke tests)
GUARDIAN_MODEL=llama-3.3-70b-versatile

# Comma-separated CORS origins for the React dev server / deployed frontend
GUARDIAN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Phase 2 only ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
